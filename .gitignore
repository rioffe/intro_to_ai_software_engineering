# The assembled book is tracked on purpose (see book.pdf at the repo root).
# The per-chapter PDFs are build artifacts -- ignore those.
manuscript/*.pdf

# mermaid-filter writes per-run diagnostics (.err) in cwd and next to outputs
*.err

# Python bytecode caches (tools/*.py)
__pycache__/
*.pyc

# Editor / OS temp files
*~
*.swp
.DS_Store
